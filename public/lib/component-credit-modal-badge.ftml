pathname: component:credit-modal-badge
title: クレジットモーダル用バッジ
source: https://scp-jp.wikidot.com/component:credit-modal-badge
-----
[[div_ class="optionalbadge {$name}"]]
[[image https://scp-jp-storage.wdfiles.com/local--files/file%3A3438721-114-z4ps/usaidan.svg class="odango2021" link="http://scp-jp.wikidot.com/pile-up-dumplings-2021"]]
[[image https://scp-jp-storage.wdfiles.com/local--files/file%3A2577572-285-hkyb/gekkahyojin.svg class="matchmaking2021" link="http://scp-jp.wikidot.com/matchmaking2021"]]
[[image https://scp-jp-storage.wdfiles.com/local--files/file%3A3438721-271-bicn/overhaul.svg class="overhaul" link="http://scp-jp.wikidot.com/overhaul-campaign"]]
[[image https://scp-jp-storage.wdfiles.com/local--files/file%3A3438721-276-um73/overlord.svg class="overlord" link="http://scp-jp.wikidot.com/overlord-campaign"]]
[[image https://scp-jp-storage.wdfiles.com/local--files/file%3A3438721-287-9fqx/overbuild.svg class="overbuild" link="http://scp-jp.wikidot.com/overbuild-campaign"]]
[[/div]]
[[module css]]
.optionalbadge{
  position: absolute;
  bottom: 0;
  left: 12.5%;
  z-index: 1;
}
#page-content .optionalbadge img {
  display: none;
}
#page-content .optionalbadge.odango2021 img.odango2021,
#page-content .optionalbadge.matchmaking2021 img.matchmaking2021,
#page-content .optionalbadge.overhaul img.overhaul,
#page-content .optionalbadge.overlord img.overlord,
#page-content .optionalbadge.overbuild img.overbuild {
  display: unset;
  width:auto;
  height:45px;
  top:-10px;
  position: relative;
}
[[/module]]
