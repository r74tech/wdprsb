pathname: component:image-block-left-base
title: 画像ブロック左ベース
source: https://scp-jp.wikidot.com/component:image-block-left-base
-----
[[div class="scp-image-block block-left scp-clear-{$clear}" style="width:{$width};"]]
[[image {$name} style="width:{$width};"]]
[[div class="scp-image-caption" style="width:{$width};"]]
{$caption}
[[/div]]
[[/div]]
[[module css]]
@media (max-width: 768px) {
.scp-clear-true.scp-image-block {
float: none;
clear: both;
margin-left: auto;
margin-right: auto;
}
}
[[/module]]
